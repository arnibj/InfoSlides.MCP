# /etc/infoslides/mcp.env  (copy from this example; nothing here is a secret)
# The API the tools call, over the server loopback. Each request carries the caller's own credential.
McpHost__ApiUrl=http://127.0.0.1:5000
# The authorization server. Its OpenID discovery document supplies the keys that validate access tokens.
McpHost__Issuer=https://infoslides.app
# The URL clients connect to; also the audience an access token must carry and the metadata "resource".
McpHost__ResourceIdentifier=https://infoslides.app/mcp
# Requests per minute per caller (token client and subject, API key, or address).
McpHost__RequestsPerMinute=240
